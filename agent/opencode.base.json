{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "plugins": [
    "-opencode.tool.shell",
    "-opencode.tool.edit",
    "-opencode.tool.write",
    "-opencode.tool.patch",
    "-opencode.tool.read",
    "-opencode.tool.glob",
    "-opencode.tool.grep",
    "-opencode.tool.webfetch",
    "-opencode.tool.websearch",
    "-opencode.tool.subagent",
    "-opencode.tool.skill",
    "-opencode.tool.question",
    "-opencode.models.dev",
    "-opencode.vcs.git",
    "-opencode.vcs.hg",
    "-opencode.provider.ollama",
    "-opencode.provider.lmstudio",
    "-opencode.provider.vllm"
  ],
  "default_agent": "daily",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "daily": {
      "description": "Агент Daily Agent: только чтение из разрешённых источников",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "experimental": {
    "policies": []
  }
}
