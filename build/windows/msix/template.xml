<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="daily-agent"
        Arguments=""
        InstallLocation="C:\Program Files\Daily Agent\Daily Agent">
    </Installer>
    <PackageInformation
        PackageName="Daily Agent"
        PackageDisplayName="Daily Agent"
        PublisherName="CN=Daily Agent"
        PublisherDisplayName="Daily Agent"
        Version="0.1.0.0"
        PackageDescription="Личный рабочий помощник">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="local.dailyagent.app"
                Description="Личный рабочий помощник"
                DisplayName="Daily Agent"
                ExecutableName="daily-agent"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Daily Agent</DisplayName>
            <PublisherDisplayName>Daily Agent</PublisherDisplayName>
            <Description>Личный рабочий помощник</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="daily-agent.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
